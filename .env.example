# Copy to .env and fill in. Do NOT commit real secrets.

# ── App (Expo) ───────────────────────────────────────────────────────────────
# Public URL of the deployed Reverb valuation proxy (see functions/reverb-valuation).
# EXPO_PUBLIC_* vars are embedded in the client bundle, so this must be a URL only —
# never a secret. When unset, utils/valuation.js falls back to the local mock.
EXPO_PUBLIC_VALUATION_URL=

# ── Server-side only (the valuation proxy / Lambda) ──────────────────────────
# Reverb personal access token, 'public' scope is sufficient.
# Set this in the function's environment (e.g. Lambda config / Amplify env),
# NOT in the app build. See docs/backlog.md item #3 for how to generate one.
REVERB_TOKEN=
